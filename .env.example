MONGO_URI=mongodb://localhost:27017
# Default database. Reach any other with get_database("OTHER_DB").
DB_NAME=EXAMPLE
WORKER_COUNT=1

# Must be at least 32 characters - generate with: openssl rand -hex 32
JWT_SECRET_KEY=6bfc976f-8035-47b6-994f-0b07f851917d # Change this
# Idle window: each authenticated request slides it forward
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
# Hard cap from first login, however active the session is
JWT_MAX_SESSION_MINUTES=1440

# Auth hardening
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# RBAC: admins are created with `python create_admin.py grant <email>`

# Comma-separated origins. "*" disables credentialed CORS, since browsers
# reject a wildcard origin on credentialed requests.
CORS_ORIGINS=*
